# ==========================================================================
#  Digital Visiting Card SaaS - Apache Front Controller
# ==========================================================================

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- Force HTTPS when APP_FORCE_HTTPS is handled at app level too ------
    # (Enable the two lines below on production with a valid certificate)
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # --- Block access to sensitive directories ----------------------------
    RewriteRule ^(app|config|database|storage|bin|vendor)/ - [F,L]
    RewriteRule ^(\.env|\.env\..*|\.user\.ini|composer\.(json|lock))$ - [F,L]

    # --- Serve real files / directories as-is -----------------------------
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # --- Everything else goes through the front controller ----------------
    RewriteRule ^ index.php [L]
</IfModule>

# --- Security headers for static files ------------------------------------
# PHP responses set their own headers, and they vary by page: the card and
# template previews are meant to be embedded while everything else refuses
# framing outright. "Header always set" would overwrite that decision with a
# single value for the whole site, so these apply only to files Apache serves
# without going through the application.
<IfModule mod_headers.c>
    <FilesMatch "\.(?i:css|js|mjs|map|png|jpe?g|gif|svg|webp|avif|ico|woff2?|ttf|otf|eot|txt|xml|json|webmanifest)$">
        Header always set X-Content-Type-Options "nosniff"
        Header always set Referrer-Policy "strict-origin-when-cross-origin"
        Header always set X-Frame-Options "SAMEORIGIN"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg      "access plus 1 year"
    ExpiresByType image/png       "access plus 1 year"
    ExpiresByType image/webp      "access plus 1 year"
    ExpiresByType image/svg+xml   "access plus 1 year"
    ExpiresByType text/css        "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2      "access plus 1 year"
</IfModule>

# --- PHP settings ---------------------------------------------------------
# php_flag / php_value are only understood when PHP runs as an Apache module.
# Most hosting runs PHP as FPM, CGI or LiteSpeed, where Apache rejects these
# directives outright and answers every request with 500 before PHP is ever
# reached. The guards below keep them working on mod_php; everywhere else the
# same settings come from .user.ini, which PHP reads directly.
<IfModule mod_php.c>
    php_flag display_errors off
    php_value upload_max_filesize 16M
    php_value post_max_size 20M
</IfModule>
<IfModule mod_php7.c>
    php_flag display_errors off
    php_value upload_max_filesize 16M
    php_value post_max_size 20M
</IfModule>
<IfModule mod_php5.c>
    php_flag display_errors off
    php_value upload_max_filesize 16M
    php_value post_max_size 20M
</IfModule>
