# ==========================================================================
#  Digital Visiting Card SaaS - Apache Front Controller
# ==========================================================================

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- Force HTTPS when APP_FORCE_HTTPS is handled at app level too ------
    # (Enable the two lines below on production with a valid certificate)
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # --- Block access to sensitive directories ----------------------------
    RewriteRule ^(app|config|database|storage|bin|vendor)/ - [F,L]
    RewriteRule ^(\.env|\.env\..*|composer\.(json|lock))$ - [F,L]

    # --- Serve real files / directories as-is -----------------------------
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # --- Everything else goes through the front controller ----------------
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=()"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg      "access plus 1 year"
    ExpiresByType image/png       "access plus 1 year"
    ExpiresByType image/webp      "access plus 1 year"
    ExpiresByType image/svg+xml   "access plus 1 year"
    ExpiresByType text/css        "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2      "access plus 1 year"
</IfModule>

php_flag display_errors off
php_value upload_max_filesize 16M
php_value post_max_size 20M
