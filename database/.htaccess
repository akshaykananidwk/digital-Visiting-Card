# Apache 2.4 uses Require; the 2.2 syntax below only applies where
# mod_access_compat is loaded. An unguarded directive from the wrong era is
# an unknown command, and Apache answers 500 for every request underneath it.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
